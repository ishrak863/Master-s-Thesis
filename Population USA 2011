// Define the USA boundary
var usa = ee.FeatureCollection("USDOS/LSIB_SIMPLE/2017")
             .filter(ee.Filter.eq('country_na', 'United States'));

// Get WorldPop population data for 2011
var pop2011 = ee.ImageCollection("WorldPop/GP/100m/pop")
                   .filter(ee.Filter.date('2011-01-01', '2011-12-31'))
                   .mosaic()
                   .clip(usa);

// Export to Google Drive
Export.image.toDrive({
  image: pop2011,
  description: 'USA_WorldPop_2011',
  folder: 'EarthEngineExports',  // Change to your desired folder name
  scale: 100,
  region: usa.geometry().bounds(),
  crs: 'EPSG:4326',
  maxPixels: 1e12
});
